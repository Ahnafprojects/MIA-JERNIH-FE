# Alamat backend Jernih (MIA-JERNIH-BE).
# Jangan taruh rahasia apa pun di berkas ber-prefix NEXT_PUBLIC_:
# nilainya ikut terkirim ke browser.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Basemap peta. Gaya vector CARTO gratis dan tanpa API key.
# Tile RASTER CARTO sekarang menuntut kunci dan membalas petak
# bertuliskan "API KEY REQUIRED" — jangan dipakai.
NEXT_PUBLIC_MAP_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
NEXT_PUBLIC_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
